  },
  "dependencies": {
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.1.0",
    "prettier": "3.9.8"
  }
}
